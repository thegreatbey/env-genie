{
  "name": "env-genie",
  "version": "0.0.1",
  "description": "Fast .env linter for humans and CI. Validate and lint .env files; emit SARIF for CI.",
  "bin": {
    "env-genie": "dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/thegreatbey/env-genie"
  },
  "homepage": "https://github.com/thegreatbey/env-genie#readme",
  "bugs": {
    "url": "https://github.com/thegreatbey/env-genie/issues"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "postbuild": "node -e \"const fs=require('fs');const p='dist/cli.js';fs.writeFileSync(p,'#!/usr/bin/env node\\n'+fs.readFileSync(p,'utf8'))\"",
    "dev": "tsc -w",
    "lint": "echo \"(add eslint later)\"",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "picocolors": "^1.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "dotenv",
    "env",
    "lint",
    "ci",
    "sarif"
  ],
  "license": "MIT",
  "author": "TheGreatBey",
  "contributors": [
    "Cavani21"
  ],
  "sideEffects": false
}
